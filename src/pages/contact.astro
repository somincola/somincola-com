---
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import { SITE, fullAddress } from '~/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  url: `${SITE.url}/contact`,
  name: 'Contact Somincola',
  about: { '@id': `${SITE.url}/#organization` },
};

const field =
  'mt-2 block w-full rounded-xl border border-ink/15 bg-paper/60 px-4 py-3 text-[15px] text-ink placeholder:text-muted/70 transition focus:border-ink/50 focus:bg-surface focus:outline-none focus:ring-4 focus:ring-[rgb(var(--accent)/0.12)]';
---

<Base
  title="Contact"
  description="Get in touch with Somincola LLC — questions about our apps, support, partnerships or press. We read every message and reply personally."
  jsonLd={jsonLd}
>
  <PageHero
    eyebrow="Contact"
    title="Let’s start a <em>conversation.</em>"
    lead="Questions about our apps, support requests, partnerships or press — we read every message and reply personally, usually within two business days."
  />

  <section class="container-site pb-8">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7" data-reveal>
        <form
          class="rounded-[1.75rem] border border-line bg-surface p-6 sm:p-10"
          data-contact-form
          action={`mailto:${SITE.email}`}
          method="post"
          novalidate
        >
          <div class="grid gap-6 sm:grid-cols-2">
            <label class="block text-sm font-medium">
              Name
              <input name="name" type="text" autocomplete="name" required class={field} placeholder="Jane Appleseed" />
            </label>
            <label class="block text-sm font-medium">
              Email
              <input
                name="email"
                type="email"
                autocomplete="email"
                required
                class={field}
                placeholder="jane@example.com"
              />
            </label>
          </div>
          <label class="mt-6 block text-sm font-medium">
            Message
            <textarea name="message" rows="6" required class={field} placeholder="How can we help?"></textarea>
          </label>
          <label class="hidden" aria-hidden="true">
            Company
            <input name="company" type="text" tabindex="-1" autocomplete="off" />
          </label>

          <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <p class="max-w-xs text-xs leading-relaxed text-muted">
              By sending, you agree to our <a href="/privacy" class="underline underline-offset-2">Privacy Policy</a>.
            </p>
            <button type="submit" class="btn-primary justify-center disabled:opacity-60" data-submit>
              Send message
            </button>
          </div>
          <p class="mt-5 hidden text-sm" role="status" aria-live="polite" data-status></p>
        </form>
      </div>

      <aside class="space-y-10 lg:col-span-4 lg:col-start-9" data-reveal>
        <div>
          <p class="eyebrow">Email</p>
          <a href={`mailto:${SITE.email}`} class="link-underline mt-3 inline-block text-xl">{SITE.email}</a>
        </div>
        <div>
          <p class="eyebrow">App support</p>
          <p class="mt-3 text-[15px] leading-relaxed text-muted">
            Using Moro for Mastodon? Visit <a
              href="https://getmoro.app"
              class="link-underline text-ink"
              target="_blank"
              rel="noopener">getmoro.app</a
            > or email us with your device and app version.
          </p>
        </div>
        <div>
          <p class="eyebrow">Mailing address</p>
          <address class="mt-3 text-[15px] not-italic leading-relaxed text-muted">
            {SITE.legalName}<br />
            {fullAddress}
          </address>
        </div>
        <div>
          <p class="eyebrow">Languages</p>
          <p class="mt-3 text-[15px] text-muted">English · 中文</p>
        </div>
      </aside>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = form?.querySelector<HTMLElement>('[data-status]');
  const button = form?.querySelector<HTMLButtonElement>('[data-submit]');

  const show = (text: string, ok: boolean) => {
    if (!status) return;
    status.textContent = text;
    status.classList.remove('hidden');
    status.classList.toggle('text-accent', !ok);
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    const data = Object.fromEntries(new FormData(form).entries());
    if (button) {
      button.disabled = true;
      button.textContent = 'Sending…';
    }
    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(data),
      });
      const json = (await res.json().catch(() => ({}))) as { ok?: boolean };
      if (!res.ok || !json.ok) throw new Error('Request failed');
      form.reset();
      show('Thank you — your message is on its way. We’ll be in touch soon.', true);
    } catch {
      show('Something went wrong. Please email us directly at contact@somincola.com.', false);
    } finally {
      if (button) {
        button.disabled = false;
        button.textContent = 'Send message';
      }
    }
  });
</script>
