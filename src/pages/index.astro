---
import Base from '~/layouts/Base.astro';
import PhonePlate from '~/components/home/PhonePlate.astro';
import NetworkPlate from '~/components/home/NetworkPlate.astro';
import { SITE, PRODUCTS, fullAddress } from '~/site';

const principles = [
  {
    title: 'Focus',
    body: 'We build a small number of products and give each one our full attention. Fewer features, better made.',
  },
  {
    title: 'Privacy by default',
    body: 'No advertising, no third-party trackers, no data brokers. We collect only what a product needs to work.',
  },
  {
    title: 'Native craft',
    body: 'Software that feels at home on its platform — fast, accessible, and considered down to the last detail.',
  },
  {
    title: 'Built to last',
    body: 'Independent and sustainably funded by the people who use our products, not by investors or advertisers.',
  },
];

const capabilities = [
  { area: 'Apple platforms', detail: 'Native iOS and macOS apps in Swift and SwiftUI' },
  { area: 'Open social web', detail: 'ActivityPub and Mastodon clients, servers and integrations' },
  { area: 'Web', detail: 'Fast, accessible websites and web apps in TypeScript' },
  { area: 'Infrastructure', detail: 'Self-hosted services, edge delivery and reliable operations' },
];

const plates = { Moro: PhonePlate, 'm.somincola.org': NetworkPlate } as const;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${SITE.url}/#organization`,
    name: SITE.name,
    legalName: SITE.legalName,
    url: SITE.url,
    logo: `${SITE.url}/icon-512.png`,
    description: SITE.description,
    email: SITE.email,
    address: {
      '@type': 'PostalAddress',
      streetAddress: SITE.address.street,
      addressLocality: SITE.address.locality,
      addressRegion: SITE.address.region,
      postalCode: SITE.address.postalCode,
      addressCountry: SITE.address.country,
    },
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'customer support',
      email: SITE.email,
      availableLanguage: ['English', 'Chinese'],
    },
    sameAs: PRODUCTS.map((p) => p.href),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    url: SITE.url,
    name: SITE.name,
    inLanguage: 'en',
    publisher: { '@id': `${SITE.url}/#organization` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    name: 'Moro for Mastodon',
    operatingSystem: 'iOS',
    applicationCategory: 'SocialNetworkingApplication',
    url: 'https://getmoro.app',
    author: { '@id': `${SITE.url}/#organization` },
  },
];
---

<Base
  description="Somincola is an independent software studio crafting focused, privacy-respecting apps for Apple platforms and the open social web. Makers of Moro for Mastodon."
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="hero-grid relative isolate overflow-hidden pb-24 pt-36 sm:pb-32 sm:pt-44 lg:pt-52">
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div
        class="absolute -right-[10%] -top-[20%] h-[42rem] w-[42rem] animate-drift rounded-full bg-[radial-gradient(circle_at_center,rgb(var(--accent)/0.20),transparent_62%)] blur-3xl"
      >
      </div>
      <div
        class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-[rgb(var(--ink)/0.12)] to-transparent"
      >
      </div>
    </div>

    <div class="container-site">
      <p class="eyebrow flex animate-rise items-center gap-3">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent"></span>
        Somincola LLC — {SITE.tagline}
      </p>

      <h1
        class="display mt-8 max-w-[15ch] animate-rise text-[3rem] [animation-delay:80ms] sm:text-[4.5rem] lg:text-[6.25rem]"
      >
        Quiet software, <em>carefully made.</em>
      </h1>

      <div class="mt-12 grid animate-rise gap-10 [animation-delay:180ms] md:mt-16 md:grid-cols-12 md:items-end">
        <p class="max-w-xl text-lg leading-relaxed text-muted md:col-span-7 sm:text-xl">
          We are an independent studio crafting focused, privacy-respecting apps for Apple platforms and the open social
          web — software that respects your attention and keeps your data yours.
        </p>
        <div class="flex flex-wrap gap-3 md:col-span-5 md:justify-end">
          <a href="#work" class="btn-primary">See our work</a>
          <a href="/contact" class="btn-ghost group">
            Get in touch <span class="arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Statement -->
  <section class="container-site py-24 sm:py-32" aria-labelledby="statement">
    <div class="grid gap-8 md:grid-cols-12">
      <p id="statement" class="eyebrow md:col-span-3" data-reveal>Our belief</p>
      <p class="text-[1.75rem] font-medium leading-[1.2] tracking-[-0.03em] sm:text-[2.4rem] md:col-span-9" data-reveal>
        The best software feels calm. It does one thing beautifully, gets out of your way, and is
        <span class="text-muted">still there years from now.</span>
      </p>
    </div>
  </section>

  <!-- Work -->
  <section id="work" class="container-site py-12 sm:py-16" aria-labelledby="work-title">
    <div class="flex items-end justify-between gap-6 border-b border-line pb-6" data-reveal>
      <h2 id="work-title" class="display text-4xl sm:text-5xl">Selected work</h2>
      <p class="eyebrow hidden sm:block">01 — 0{PRODUCTS.length}</p>
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-2">
      {
        PRODUCTS.map((product, i) => {
          const Plate = plates[product.name];
          return (
            <a
              href={product.href}
              target="_blank"
              rel="noopener"
              class="group block rounded-[1.75rem] border border-line bg-surface p-2.5 transition-shadow duration-500 hover:shadow-[0_30px_70px_-40px_rgb(0_0_0/0.45)]"
              data-reveal
              style={`--reveal-delay:${i * 120}ms`}
            >
              <div class="aspect-[4/3] overflow-hidden rounded-[1.35rem]">
                <Plate />
              </div>
              <div class="flex items-start justify-between gap-6 px-4 pb-4 pt-6 sm:px-5">
                <div>
                  <p class="eyebrow">
                    0{i + 1} · {product.kind}
                  </p>
                  <h3 class="mt-3 text-2xl font-medium tracking-[-0.02em]">{product.fullName}</h3>
                  <p class="mt-2 max-w-md text-[15px] leading-relaxed text-muted">{product.summary}</p>
                </div>
                <span class="mt-1 flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-line transition-colors duration-300 group-hover:border-ink group-hover:bg-ink group-hover:text-paper">
                  <span class="arrow" aria-hidden="true">
                    ↗
                  </span>
                  <span class="sr-only">Visit {product.linkLabel}</span>
                </span>
              </div>
            </a>
          );
        })
      }
    </div>

    <div
      class="mt-6 flex flex-col gap-4 rounded-[1.75rem] border border-dashed border-ink/15 px-7 py-7 sm:flex-row sm:items-center sm:justify-between"
      data-reveal
    >
      <p class="text-[15px] text-muted">
        <span class="text-ink">More in the studio.</span> New apps for iPhone and Mac are in development.
      </p>
      <a href="/contact" class="link-underline text-sm">Hear about launches first</a>
    </div>
  </section>

  <!-- Approach -->
  <section id="approach" class="container-site py-24 sm:py-32" aria-labelledby="approach-title">
    <div class="grid gap-8 md:grid-cols-12" data-reveal>
      <p class="eyebrow md:col-span-3">Approach</p>
      <h2 id="approach-title" class="display text-4xl sm:text-[2.75rem] md:col-span-9">
        Four principles behind everything we ship.
      </h2>
    </div>

    <div class="mt-16 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
      {
        principles.map((p, i) => (
          <div class="border-t border-ink/80 pt-6" data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <p class="font-mono text-xs text-muted">0{i + 1}</p>
            <h3 class="mt-8 text-xl font-medium tracking-[-0.02em]">{p.title}</h3>
            <p class="mt-3 text-[15px] leading-relaxed text-muted">{p.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Capabilities -->
  <section class="container-site py-12 sm:py-16" aria-labelledby="cap-title">
    <div class="grid gap-8 md:grid-cols-12">
      <div class="md:col-span-3" data-reveal>
        <p id="cap-title" class="eyebrow">What we do</p>
      </div>
      <ul class="md:col-span-9">
        {
          capabilities.map((c, i) => (
            <li
              class="grid grid-cols-1 gap-1 border-b border-line py-6 first:border-t sm:grid-cols-12 sm:items-baseline sm:gap-6"
              data-reveal
              style={`--reveal-delay:${i * 70}ms`}
            >
              <span class="text-2xl font-medium tracking-[-0.03em] sm:col-span-5 sm:text-[1.75rem]">{c.area}</span>
              <span class="text-[15px] text-muted sm:col-span-7">{c.detail}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Company -->
  <section class="container-site py-24 sm:py-32" aria-labelledby="company-title">
    <div class="grid gap-12 rounded-[2rem] border border-line bg-surface p-8 sm:p-12 md:grid-cols-12" data-reveal>
      <div class="md:col-span-5">
        <p class="eyebrow">The company</p>
        <h2 id="company-title" class="display mt-6 text-4xl sm:text-5xl">Small by design.</h2>
        <p class="mt-5 max-w-sm text-[15px] leading-relaxed text-muted">
          Somincola is a founder-led company registered in Wyoming, United States, and working with people around the
          world.
        </p>
        <a href="/about" class="link-underline mt-8 inline-block text-sm">More about us →</a>
      </div>
      <dl class="grid gap-x-8 text-sm sm:grid-cols-2 md:col-span-7">
        {
          [
            ['Legal name', SITE.legalName],
            ['Entity', 'Limited liability company'],
            ['Jurisdiction', 'Wyoming, United States'],
            ['Payments', 'Processed securely by Stripe'],
            ['Registered address', fullAddress],
            ['Contact', SITE.email],
          ].map(([k, v]) => (
            <div class="border-b border-line py-4">
              <dt class="eyebrow">{k}</dt>
              <dd class="mt-1.5 text-[15px]">{v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- CTA -->
  <section class="container-site pb-8 pt-8" aria-labelledby="cta-title">
    <div class="text-center" data-reveal>
      <p class="eyebrow">Say hello</p>
      <h2 id="cta-title" class="display mx-auto mt-6 max-w-[18ch] text-5xl sm:text-6xl">
        Have something in mind? <em>Let’s talk.</em>
      </h2>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href="/contact" class="btn-primary">Start a conversation</a>
        <a href={`mailto:${SITE.email}`} class="btn-ghost">{SITE.email}</a>
      </div>
    </div>
  </section>
</Base>
