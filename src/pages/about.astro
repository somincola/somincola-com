---
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import { SITE, PRODUCTS, fullAddress } from '~/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  url: `${SITE.url}/about`,
  name: 'About Somincola',
  about: { '@id': `${SITE.url}/#organization` },
};
---

<Base
  title="About"
  description="Somincola LLC is a founder-led, independent software company registered in Wyoming, USA. We design, build and operate focused apps and services for Apple platforms and the open social web."
  jsonLd={jsonLd}
>
  <PageHero
    eyebrow="About"
    title="An independent studio for <em>considered software.</em>"
    lead="Somincola is a founder-led software company. We design, build and operate our own products end to end — from native apps to the servers behind them."
  />

  <section class="container-site py-16 sm:py-24">
    <div class="grid gap-10 md:grid-cols-12">
      <p class="eyebrow md:col-span-3" data-reveal>Why we exist</p>
      <div class="space-y-6 text-lg leading-relaxed text-ink/85 md:col-span-8 sm:text-xl" data-reveal>
        <p>
          Too much of today’s software is designed to capture attention rather than serve it. We started Somincola to
          make the opposite: tools that are quiet, fast and honest about what they do.
        </p>
        <p class="text-muted">
          Staying small is a deliberate choice. It lets us move carefully, keep our products free of advertising and
          tracking, and answer every message ourselves.
        </p>
      </div>
    </div>
  </section>

  <section class="container-site py-16 sm:py-24">
    <div class="grid gap-10 md:grid-cols-12">
      <p class="eyebrow md:col-span-3" data-reveal>What we make</p>
      <ul class="md:col-span-9">
        {
          PRODUCTS.map((p) => (
            <li class="border-b border-line first:border-t" data-reveal>
              <a
                href={p.href}
                target="_blank"
                rel="noopener"
                class="group grid gap-2 py-8 sm:grid-cols-12 sm:items-baseline sm:gap-6"
              >
                <span class="text-2xl font-medium tracking-[-0.03em] sm:col-span-5 sm:text-3xl">{p.fullName}</span>
                <span class="text-[15px] leading-relaxed text-muted sm:col-span-6">{p.summary}</span>
                <span class="arrow text-muted sm:col-span-1 sm:text-right" aria-hidden="true">
                  ↗
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="container-site py-16 sm:py-24">
    <div class="grid gap-10 md:grid-cols-12">
      <p class="eyebrow md:col-span-3" data-reveal>How we work</p>
      <div class="grid gap-x-10 gap-y-10 sm:grid-cols-2 md:col-span-9">
        {
          [
            ['Product first', 'We build and maintain our own products, so every decision is made for the long run.'],
            ['Remote by nature', 'We work asynchronously with collaborators across time zones and languages.'],
            ['Open standards', 'We favor open protocols like ActivityPub, so people are never locked in.'],
            ['Direct support', 'Questions go straight to the people who build the product — no ticket mazes.'],
          ].map(([title, body]) => (
            <div data-reveal>
              <h3 class="text-lg font-medium tracking-[-0.01em]">{title}</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-muted">{body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="container-site py-16 sm:py-24" aria-labelledby="details">
    <div class="grid gap-10 md:grid-cols-12">
      <h2 id="details" class="eyebrow md:col-span-3" data-reveal>Company details</h2>
      <dl class="grid gap-x-10 sm:grid-cols-2 md:col-span-9" data-reveal>
        {
          [
            ['Legal name', SITE.legalName],
            ['Entity type', 'Single-member limited liability company'],
            ['State of formation', 'Wyoming, United States'],
            ['Registered address', fullAddress],
            ['General enquiries', SITE.email],
            ['Customer support', SITE.email],
          ].map(([k, v]) => (
            <div class="border-b border-line py-5">
              <dt class="eyebrow">{k}</dt>
              <dd class="mt-1.5 text-base">
                {v.includes('@') ? (
                  <a class="link-underline" href={`mailto:${v}`}>
                    {v}
                  </a>
                ) : (
                  v
                )}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>
</Base>
