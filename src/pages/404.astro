---
import Base from '~/layouts/Base.astro';
---

<Base title="Page not found" description="The page you are looking for does not exist." noindex>
  <section class="container-site flex min-h-[70vh] flex-col justify-center pt-32">
    <p class="eyebrow">Error 404</p>
    <h1 class="display mt-6 text-6xl sm:text-8xl">Nothing <em class="text-accent">here.</em></h1>
    <p class="mt-6 max-w-md text-lg text-muted">The page you’re looking for has moved or never existed.</p>
    <div class="mt-10">
      <a href="/" class="btn-primary">Back to home</a>
    </div>
  </section>
</Base>
