---
// Abstract, brand-neutral illustration of a calm reading timeline (no third-party marks).
---

<div class="relative h-full w-full overflow-hidden bg-[#141412]">
  <div
    class="absolute -right-24 -top-24 h-80 w-80 rounded-full bg-[radial-gradient(circle_at_center,rgb(226_133_96/0.55),transparent_65%)] blur-2xl"
  >
  </div>
  <div
    class="absolute -bottom-32 -left-20 h-96 w-96 rounded-full bg-[radial-gradient(circle_at_center,rgb(120_130_255/0.28),transparent_65%)] blur-2xl"
  >
  </div>
  <div
    class="absolute left-1/2 top-[14%] h-[120%] w-[46%] min-w-[180px] max-w-[250px] -translate-x-1/2 rounded-[2.4rem] border border-white/15 bg-white/[0.04] p-3 shadow-[0_40px_80px_-30px_rgb(0_0_0/0.8)] backdrop-blur-sm transition-transform duration-700 ease-out group-hover:-translate-y-3"
  >
    <div class="h-full rounded-[1.9rem] bg-[#1d1d1a] px-4 pt-5">
      <div class="mx-auto mb-5 h-1.5 w-14 rounded-full bg-white/15"></div>
      {
        [0.9, 0.7, 0.8, 0.6].map((w, i) => (
          <div class="mb-4 flex gap-3 border-b border-white/[0.06] pb-4">
            <div class:list={['h-7 w-7 shrink-0 rounded-full', i % 2 ? 'bg-white/15' : 'bg-[rgb(226_133_96/0.7)]']} />
            <div class="flex-1 space-y-1.5 pt-0.5">
              <div class="h-1.5 w-1/3 rounded-full bg-white/30" />
              <div class="h-1.5 rounded-full bg-white/[0.12]" style={`width:${w * 100}%`} />
              <div class="h-1.5 rounded-full bg-white/[0.12]" style={`width:${w * 70}%`} />
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>
