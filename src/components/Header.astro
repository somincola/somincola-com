---
import Logo from '~/components/Logo.astro';
import { NAV } from '~/site';

const path = Astro.url.pathname.replace(/\.html$/, '');
---

<header class="fixed inset-x-0 top-0 z-50" data-header>
  <div
    class="absolute inset-0 -z-10 border-b border-transparent transition-colors duration-500 [[data-scrolled]_&]:border-line [[data-scrolled]_&]:bg-paper/75 [[data-scrolled]_&]:backdrop-blur-xl"
  >
  </div>
  <div class="container-site flex h-16 items-center justify-between sm:h-[4.5rem]">
    <a href="/" aria-label="Somincola — home" class="rounded-lg">
      <Logo />
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-1 md:flex">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class:list={[
              'rounded-full px-3.5 py-2 text-sm transition-colors hover:text-ink',
              path === item.href ? 'text-ink' : 'text-muted',
            ]}
            aria-current={path === item.href ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a href="/contact" class="btn-primary ml-3 !py-2">Start a conversation</a>
    </nav>

    <details class="group relative md:hidden">
      <summary
        class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-full border border-ink/15 [&::-webkit-details-marker]:hidden"
        aria-label="Open menu"
      >
        <span class="relative block h-3 w-4">
          <span
            class="absolute left-0 top-0 h-px w-4 bg-ink transition-transform duration-300 group-open:translate-y-[5.5px] group-open:rotate-45"
          ></span>
          <span
            class="absolute bottom-0 left-0 h-px w-4 bg-ink transition-transform duration-300 group-open:-translate-y-[5.5px] group-open:-rotate-45"
          ></span>
        </span>
      </summary>
      <div
        class="absolute right-0 top-12 w-60 overflow-hidden rounded-2xl border border-line bg-surface p-2 shadow-[0_24px_60px_-20px_rgb(0_0_0/0.25)]"
      >
        {
          NAV.map((item) => (
            <a href={item.href} class="block rounded-xl px-4 py-3 text-[15px] hover:bg-ink/[0.04]">
              {item.label}
            </a>
          ))
        }
      </div>
    </details>
  </div>
</header>
