---
import { ANALYTICS } from '~/config';

const id = ANALYTICS?.vendors?.googleAnalytics?.id;
const scriptType = ANALYTICS?.vendors?.googleAnalytics?.partytown ? 'text/partytown' : undefined;
const initScript = id
  ? `window.dataLayer = window.dataLayer || [];
function gtag() { window.dataLayer.push(arguments); }
gtag('js', new Date());
gtag('config', ${JSON.stringify(String(id))});`
  : '';
---

{
  id ? (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${id}`} type={scriptType} />
      <script is:inline set:html={initScript} type={scriptType} />
    </>
  ) : null
}
