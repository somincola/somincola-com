---
import Base from '~/layouts/Base.astro';

export interface Props {
  frontmatter: { title: string; description: string; updated: string };
}
const { frontmatter } = Astro.props;
---

<Base title={frontmatter.title} description={frontmatter.description}>
  <article class="container-site pb-8 pt-36 sm:pt-44">
    <div class="grid gap-12 md:grid-cols-12">
      <header class="md:col-span-4">
        <div class="md:sticky md:top-32">
          <p class="eyebrow flex items-center gap-3">
            <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent"></span>Legal
          </p>
          <h1 class="display mt-6 text-5xl sm:text-6xl">{frontmatter.title}</h1>
          <p class="mt-6 text-sm text-muted">Last updated {frontmatter.updated}</p>
        </div>
      </header>
      <div
        class="prose prose-neutral max-w-none md:col-span-8 md:col-start-5 prose-headings:font-medium prose-headings:tracking-[-0.02em] prose-h2:mt-14 prose-h2:border-t prose-h2:border-line prose-h2:pt-8 prose-h2:text-2xl prose-p:text-ink/80 prose-a:text-ink prose-a:underline-offset-4 prose-strong:text-ink prose-li:text-ink/80 dark:prose-invert"
      >
        <slot />
      </div>
    </div>
  </article>
</Base>
